# Copy to .env and edit. Every value has a working default, so the app runs
# without this file at all — use it to change ports, credentials or timezone.

# ── Web ─────────────────────────────────────────────────────────────────────
# Where the UI is published on the host.
HTTP_PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=openlibrary
DB_USER=openlibrary
DB_PASSWORD=change-me-in-production
# Only used if you uncomment the `ports` block for `db` in docker-compose.yml.
DB_PORT=5432

# ── Backups ─────────────────────────────────────────────────────────────────
# Seconds between dumps (86400 = daily).
BACKUP_INTERVAL=86400
# Dumps older than this are deleted.
KEEP_DAYS=14

# ── Misc ────────────────────────────────────────────────────────────────────
TZ=UTC